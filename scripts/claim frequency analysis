## Claim Frequency by Age Group

> insurance_claims %>%
+   count(age_group)
# A tibble: 5 × 2
  age_group     n
  <fct>     <int>
1 15-25        40
2 25-35       352
3 35-45       385
4 45-55       159
5 55+          64
> library(ggplot2)
> 
> ggplot(insurance_claims,
+        aes(x = age_group)) +
+   geom_bar() +
+   labs(
+     title = "Claim Frequency by Age Group",
+     x = "Age Group",
+     y = "Number of Claims"
+   )

