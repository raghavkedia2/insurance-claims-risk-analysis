> mean(insurance_claims$policy_annual_premium)
[1] 1256.406
> 
> insurance_claims$premium_multiplier <- ifelse(
+   insurance_claims$risk_category == "Very Low Risk", 0.85,
+   ifelse(
+     insurance_claims$risk_category == "Low Risk", 0.95,
+     ifelse(
+       insurance_claims$risk_category == "Medium Risk", 1.00,
+       ifelse(
+         insurance_claims$risk_category == "High Risk", 1.15,
+         1.30
+       )
+     )
+   )
+ )
> 
> insurance_claims$recommended_premium <-
+   1256.406 * insurance_claims$premium_multiplier
> insurance_claims %>%
+   group_by(risk_category) %>%
+   summarise(
+     avg_current_premium = mean(policy_annual_premium),
+     avg_recommended_premium = mean(recommended_premium),
+     count = n()
+   )
